# Copy to .env and adjust. Never commit the real .env.
POSTGRES_USER=notes
POSTGRES_PASSWORD=change-me
POSTGRES_DB=notes
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg://notes:change-me@localhost:5432/notes
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
# open | invite | closed (production uses invite)
SIGNUP_MODE=open
BACKEND_PORT=8000

# Frontend (baked in at build time by Vite)
VITE_API_BASE_URL=http://localhost:8000
FRONTEND_PORT=5173
